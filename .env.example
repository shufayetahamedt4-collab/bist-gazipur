# ---------------------------------------------------------------------------
# Supabase (Phase 1)
#
# Copy this file to `.env` and fill in the values from your project's
# Settings → API page.
#
# The anon key is designed to be public: it ships in the browser bundle and is
# safe *only* because Row Level Security is enabled on every table (see
# supabase/migrations/0001_init.sql, which fails loudly if any table is missed).
#
# NEVER put the `service_role` key here. It bypasses RLS entirely, and anything
# in a Vite `VITE_` variable is compiled into the public JavaScript.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# ---------------------------------------------------------------------------
# Legacy — carried over from the original AI Studio scaffold.
#
# `express` and `@google/genai` are declared in package.json but imported
# nowhere in src/, so nothing reads these two values today. Left in place rather
# than deleted so an existing local .env keeps working; they can be removed in
# the same change that drops those two dependencies from package.json (which
# must also regenerate package-lock.json, since the deploy workflow runs `npm ci`).
# ---------------------------------------------------------------------------
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
